{
  "name": "minecraft-afk-bot",
  "version": "2.2",
  "description": "Robust AFK bot for Minecraft servers with infinite uptime.",
  "main": "index.js",
  "scripts": {
    "start": "node --max-old-space-size=128 index.js",
    "start:split": "node --max-old-space-size=128 index.js",
    "start:minecraft": "set BOTMINECRAFT_ROLE=minecraft&& set BOTMINECRAFT_SPLIT=false&& node --max-old-space-size=128 index.js",
    "start:single": "set BOTMINECRAFT_SPLIT=false&& node --max-old-space-size=128 index.js",
    "test": "node --check index.js",
    "postinstall": "node scripts/prune-minecraft-data.js"
  },
  "author": "Lamgerr",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^4.18.1",
    "minecraft-data": "^3.103.0",
    "mineflayer": "^4.34.0",
    "mineflayer-pathfinder": "^2.1.1"
  }
}
